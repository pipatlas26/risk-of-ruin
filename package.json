  "keywords": ["risk-of-ruin", "monte-carlo", "drawdown", "position-sizing", "trading", "fixed-fractional", "simulation", "forex"],
  "license": "MIT",
  "engines": { "node": ">=14" },
  "repository": { "type": "git", "url": "git+https://github.com/pipatlas/risk-of-ruin.git" },
